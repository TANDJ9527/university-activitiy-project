PORT=3001
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=program
JWT_SECRET=use-a-long-random-string

# 邮件验证码（QQ 邮箱 SMTP，不配置时验证码打印在服务端控制台）
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=465
# SMTP_SECURE=1
# SMTP_USER=your_qq@qq.com
# SMTP_PASS=your_smtp_authorization_code
# SMTP_FROM=your_qq@qq.com
# 开发环境在接口响应中返回验证码（仅本地调试）
# EMAIL_DEV_EXPOSE=1
