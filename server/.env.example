# 校园活动发布平台 - 环境变量配置示例
# 复制此文件为 server/.env 并修改配置（与 package.json 同目录）
# 首次使用：在 server 目录执行 npm run setup 创建库 program 与表，再 npm run dev

# MySQL 数据库配置
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password_here
MYSQL_DATABASE=program

# JWT 密钥（用于用户认证）
# 可以使用以下命令生成随机密钥: openssl rand -hex 32
JWT_SECRET=your_jwt_secret_here

# 服务器端口
PORT=3001

# --- 登录与演示账号（不写密码进仓库）---
# 1. 在 server 目录执行: npm run seed:mysql
# 2. 终端会打印各测试账号邮箱与密码；主管理员邮箱在 seed-mysql.js 中配置（约第 94 行），密码由该脚本设定。
# 3. 若登录提示「邮箱或密码错误」：多半是尚未执行 seed，或 MYSQL_DATABASE / MySQL 连接与写入种子时用的库不一致。
# 4. 团队内部保管真实密码请用密码管理器或内部文档，勿把生产环境密码写进 Git。
